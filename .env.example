# Copy to `.env` and fill in. `.env` is gitignored.

# Full backend URL (optional — highest priority)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# LAN IP of the machine running the Express server (optional — port defaults to 3000).
# In Expo dev, the app often infers this from Metro; set this if TTS still fails (e.g. tunnel mode).
# EXPO_PUBLIC_IP_ADDRESS=192.168.1.10
